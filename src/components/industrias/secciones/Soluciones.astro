---
interface Solucion {
    title: string;
    description: string;
    img: string;
}

interface Props {
    soluciones: Solucion[];
}

const { soluciones } = Astro.props;
---

<!-- ===================== Soluciones ===================== -->
<section
    class="bg-primary-light px-4 py-14 sm:px-6 sm:py-16 md:px-10 md:py-18 lg:px-20 lg:py-20"
>
    <div class="mx-auto max-w-6xl">

        <h2
            class="mx-auto text-center text-2xl font-light leading-7 sm:text-3xl md:max-w-md md:text-3xl"
        >
            <slot name="titulo" />
        </h2>

        <div
            class="mt-8 grid gap-5 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3"
        >
            {
                soluciones.map((item) => (
                    <div class="relative mx-auto w-full max-w-[360px] sm:max-w-none">

                        <!-- Card -->
                        <img
                            src="/icons/Card.svg"
                            alt=""
                            class="block h-auto w-full"
                        />

                        <!-- Contenido dentro de la card -->
                        <div
                            class="absolute inset-0 flex flex-col items-start px-10 py-12
                                   sm:px-8 sm:py-8
                                   md:px-12 md:py-16
                                   lg:px-10 lg:py-10
                                   xl:px-16 xl:py-16"
                        >

                            <!-- Logo -->
                            <div
                                class="flex h-13 w-13 shrink-0 items-center justify-center rounded-lg bg-secondary"
                            >
                                <img
                                    src={item.img}
                                    alt=""
                                    class="h-6 w-6 object-contain"
                                />
                            </div>

                            <!-- Texto -->
                            <div
                                class="mt-12 flex flex-col text-left
                                       sm:mt-8
                                       md:mt-16
                                       lg:mt-12
                                       xl:max-w-[210px]"
                            >
                                <h3
                                    class="text-xl font-semibold leading-tight text-primary
                                           sm:text-xl
                                           lg:text-2xl"
                                >
                                    {item.title}
                                </h3>

                                <p
                                    class="mt-3 text-ms font-light leading-5
                                           sm:text-base
                                           lg:text-sm lg:leading-4"
                                >
                                    {item.description}
                                </p>
                            </div>

                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>