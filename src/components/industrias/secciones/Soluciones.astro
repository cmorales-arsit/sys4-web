---
interface Solucion {
    title: string;
    description: string;
    img: string;
}

interface Props {
    soluciones: Solucion[];
}

const { soluciones } = Astro.props;
---

<!-- ===================== Soluciones ===================== -->
<section class="bg-primary-light px-6 py-16 md:px-12 lg:px-20">
    <div class="mx-auto max-w-6xl">
        <h2 class="mx-auto text-center font-light text-2xl leading-7 md:max-w-md md:text-3xl">
            <slot name="titulo" />
        </h2>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                soluciones.map((item) => (
                    <div class="relative w-full">

                        <!-- Card -->
                        <img
                            src="/icons/Card.svg"
                            alt=""
                            class="block h-auto w-full"
                        />

                        <!-- Contenido dentro de la card -->
                        <div class="absolute inset-0 flex flex-col items-start px-8 py-8 md:px-6 md:py-6 sm:px-10 sm:py-10 lg:px-16 lg:py-16">

                            <!-- Logo -->
                            <div class="flex h-13 w-13 shrink-0 items-center justify-center rounded-lg bg-secondary">
                                <img
                                    src={item.img}
                                    alt=""
                                    class="h-6 w-6 object-cover"
                                />
                            </div>

                            <!-- Texto -->
                            <div class="mt-8 flex flex-col text-left sm:mt-10 lg:mt-12 lg:max-w-[210px]">
                                <h3 class="text-xl font-semibold leading-tight text-primary sm:text-2xl">
                                    {item.title}
                                </h3>

                                <p class="mt-3 text-md font-light leading-5 md:text-sm md:leading-4">
                                    {item.description}
                                </p>
                            </div>

                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>