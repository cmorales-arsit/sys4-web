---
interface Props {
    backGround?: string;
}

const { backGround = "transparent" } = Astro.props;

interface Solucion {
    value: string;
    label: string;
}

const soluciones: Solucion[] = [
    {
        value: "erp",
        label: "ERP SYS4",
    },
    {
        value: "mes",
        label: "MES SYS4",
    },
    {
        value: "netsuite",
        label: "Oracle NetSuite",
    },
    {
        value: "jd-edwards",
        label: "Oracle JD Edwards",
    },
    {
        value: "consultoria",
        label: "Consultoría",
    },
    {
        value: "no-se",
        label: "No sé todavía",
    },
];
---

<footer class={`w-full px-4 py-10 sm:px-6 ${backGround}`}>
    <div class="mx-auto w-full max-w-2xl">
        <!-- Formulario -->
        <div class="w-full rounded-sm bg-primary px-5 py-8 sm:px-10 md:px-12">
            <div class="m-auto max-w-sm">
                <!-- Título -->
                <slot name="titulo" />
            </div>

            <div>
                <slot name="descripcion" />
            </div>
            
            

            <form class="flex flex-col gap-2">
                <!-- Nombre -->
                <input
                    type="text"
                    placeholder="Nombre y apellido"
                    class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                />

                <!-- Empresa / Email -->
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <input
                        type="text"
                        placeholder="Empresa"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />

                    <input
                        type="email"
                        placeholder="Email"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />
                </div>

                <!-- Teléfono / Solución -->
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <input
                        type="tel"
                        placeholder="Teléfono"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />

                    <select
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none focus:ring-2 focus:ring-secondary"
                        name="solucion"
                    >
                        <option value="" disabled selected>
                            ¿Qué solución te interesa?
                        </option>

                        {
                            soluciones.map((solucion) => (
                                <option value={solucion.value}>
                                    {solucion.label}
                                </option>
                            ))
                        }
                    </select>
                </div>

                <!-- Botón -->
                <button
                    type="submit"
                    class="mt-1 h-9 w-full cursor-pointer rounded bg-secondary text-sm font-medium text-white transition"
                >
                    Quiero que me contacten
                </button>
            </form>

            <!-- Redes sociales -->
            <div class="mt-6 flex justify-center gap-3 text-white">
                <!-- Facebook -->
                <a
                    href="#"
                    aria-label="Facebook"
                    class="transition"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-7 w-7"
                    >
                        <path
                            d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073c0 6.019 4.388 11.002 10.125 11.927v-8.432H7.078v-3.422h3.047V9.534c0-3.027 1.792-4.7 4.533-4.7 1.313 0 2.686.236 2.686.236v2.973h-1.514c-1.491 0-1.955.93-1.955 1.885v2.218h3.328l-.532 3.422h-2.796V24C19.612 23.075 24 18.092 24 12.073z"
                        ></path>
                    </svg>
                </a>

                <!-- Instagram -->
                <a
                    href="https://www.instagram.com/sys4_software/"
                    aria-label="Instagram"
                    class="flex h-7 w-7 items-center justify-center rounded-full bg-white text-primary transition "
                >
                    <img
                        src="/icons/Instagram.svg"
                        alt="Instagram"
                        class="h-4 w-4"
                    />
                </a>
            </div>
        </div>
    </div>
</footer>
