---

interface Step {
  number: string;
  title: string;
  description: string;
  color: string;
  rounded: string
}
 
const steps: Step[] = [
  {
    number: "1",
    title: "Diagnóstico",
    description:
      "Analizamos tu operación en profundidad: procesos, áreas, herramientas y flujos de información. Entendemos cómo funciona tu empresa antes de proponer cualquier cambio.",
    color: "primary",
    rounded: "lg:rounded-tl-3xl lg:rounded-tr-3xl lg:rounded-bl-3xl"
  },
  {
    number: "2",
    title: "Detección de riesgos",
    description:
      "Identificamos los puntos críticos, las ineficiencias y los riesgos que podrían afectar una implementación. Los nombramos antes de que se conviertan en problemas.",
    color: "secondary",
    rounded: "lg:rounded-tl-3xl lg:rounded-tr-3xl"
  },
  {
    number: "3",
    title: "Definición de la arquitectura",
    description:
      "Determinamos qué sistemas necesitás, cómo deben integrarse y en qué orden implementarlos. Sin sobredimensionar ni quedarse corto.",
    color: "primary",
    rounded: "lg:rounded-tl-3xl lg:rounded-tr-3xl lg:rounded-br-3xl"
  },
  {
    number: "4",
    title: "Plan de desembarco",
    description:
      "Diseñamos una hoja de ruta con etapas, responsables y tiempos definidos. Un plan que la organización pueda transitar sin fricciones.",
    color: "secondary",
    rounded: "lg:rounded-bl-3xl lg:rounded-br-3xl lg:rounded-tl-3xl"
  },
  {
    number: "5",
    title: "Acompañamiento",
    description:
      "Estamos presentes durante todo el proceso. La implementación no termina en el go-live — seguimos hasta que el sistema funciona como tiene que funcionar.",
    color: "primary",
    rounded: "lg:rounded-bl-3xl lg:rounded-br-3xl"
  },
];

interface Situation {
  title: string;
  desc: string;
  img:string
}

const situations: Situation[] = [
  {
    title: '"Tenemos sistemas pero no se integran"',
    desc: "Múltiples herramientas que no se hablan entre sí. La consultoría define cómo integrarlas o cuándo reemplazarlas.",
    img:"/images/consultoria/Img-2.png"
  },
  {
    title: '"Queremos implementar un ERP pero no sabemos por dónde empezar"',
    desc: "Acompañamos el proceso de decisión, evaluación y planificación antes de comprometer cualquier inversión.",
    img:"/images/consultoria/Img-3.png"
  },
  {
    title: '"Crecimos y la estructura no acompañó"',
    desc: "Cuando la operación supera al sistema, hay que rediseñar antes de seguir sumando. La consultoría define el nuevo punto de partida.",
    img:"/images/consultoria/Img-4.png"
  },
  {
    title: '"Tuvimos una implementación fallida"',
    desc: "Analizamos qué salió mal, qué quedó sin resolver y cómo retomar el camino con un plan más sólido.",
    img:"/images/consultoria/Img-5.png"
  },
];

interface Feature {
  title: string;
  description: string;
  icon: string;
}
 
const features: Feature[] = [
  {
    title: "Experiencia industrial",
    description:
      "Conocemos los procesos, los tiempos y las tensiones de cada sector. No llegamos para aprender, llegamos a resolver.",
    icon: "/icons/21.svg",
  },
  {
    title: "Visión integral",
    description:
      "Entendemos tanto la operación como la tecnología. Eso nos permite conectar los puntos que otros no ven.",
      icon: "/icons/20.svg",
  },
  {
    title: "Compromiso de largo plazo",
    description:
      "No entregamos un informe y nos vamos. Seguimos presentes hasta que el orden que diseñamos funciona en la práctica.",
      icon: "/icons/22.svg",
  },
];
---

<!-- ===================== PRINCIPAL ===================== -->
<section class="relative mt-16 overflow-hidden bg-primary py-14 sm:py-16">
    <div
        class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-8"
    >

        <!-- Columna de imagen -->
        <div
            class="relative mx-auto h-[300px] w-full max-w-[300px]
           min-[670px]:h-[420px] min-[670px]:max-w-[400px]
           min-[768px]:h-[440px] min-[768px]:max-w-md
           lg:mx-0 lg:h-[500px] lg:max-w-[500px]"
        >
            <div class="absolute inset-0 overflow-hidden">
                <img
                    src="/images/consultoria/Img-1.png"
                    alt=""
                    class="h-full w-full object-cover"
                />
            </div>
        </div>

        <!-- Columna de texto -->
        <div class="mx-auto w-full max-w-xl lg:mx-0">
            <h1
                class="text-3xl font-light leading-tight text-white sm:text-4xl lg:text-[2.75rem]"
            >
                El sistema correcto empieza por entender tu operación.
            </h1>

            <p
                class="mt-10 max-w-[500px] font-light text-md md:text-sm leading-5 text-white sm:text-base sm:leading-5"
            >
                Antes de implementar cualquier solución, SYS4 analiza cómo funciona tu empresa, detecta lo que no está funcionando y define el camino más claro hacia el orden.
            </p>

            <a
                href="#contacto"
                class="mt-8 inline-flex items-center gap-2 rounded-sm bg-secondary px-6 py-3 text-lg md:text-sm font-light text-white transition-colors "
            >
                Hablá con un consultor

                <img src="/icons/VerMas.svg" alt="" class="ms-4 h-3 w-3" />
            </a>
        </div>

        
    </div>
</section>

<!-- ===================== STEPS ===================== -->
<section class="bg-white px-6 py-16 md:px-12 lg:px-20">
  <div class="mx-auto max-w-4xl">
      <h2 class="text-center text-2xl font-semibold leading-8 md:text-3xl">
          Un proceso claro, para que
          <span class="block">nada quede librado al azar.</span>
      </h2>

      <div class="mt-10 grid grid-cols-1 overflow-hidden rounded-2xl md:grid-cols-2 lg:grid-cols-3">
          {
              steps.map((step) => (
                  <div
                      class:list={[
                          "flex min-h-[300px] flex-col rounded-3xl px-8 py-8 lg:rounded-none",
                          step.color === "primary"
                              ? "bg-primary"
                              : "bg-secondary",
                          step.rounded,
                      ]}
                  >
                      <span class="text-4xl font-light text-white">
                          {step.number}
                      </span>

                      <div class="mt-12 md:mt-8 lg:mt-auto">
    <h3 class="text-2xl font-semibold text-white">
        {step.title}
    </h3>

    <p class="mt-2 text-md md:text-sm font-light leading-5 md:leading-4 text-white">
        {step.description}
    </p>
</div>
                  </div>
              ))
          }
      </div>
  </div>
</section>

<!-- ===================== SITUACIONES ===================== -->
<section class="bg-primary-light px-6 py-16 md:px-12 lg:px-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mx-auto max-w-md text-2xl font-semibold leading-8 md:text-4xl md:max-w-xl ">
        Situaciones que la consultoría detecta antes de que escalen.
      </h2>
   
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          situations.map((item) => (
            <div>
              <!-- Imagen + título -->
              <div class="relative aspect-square overflow-hidden">
                <img
                  src={item.img}
                  alt={item.title}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
      
                <div
                  class="relative mx-auto flex h-full max-w-[300px] flex-col items-center justify-start p-6 pt-[12%] text-center"
                >
                  <h3 class="font-stack-soft text-2xl font-light leading-7 text-white">
                    {item.title}
                  </h3>
                </div>
              </div>
      
              <!-- Descripción -->
              <div class="bg-primary px-12 py-5 h-[115px] text-center">
                <p class="text-sm font-light leading-5 text-white">
                  {item.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
</section>

<!-- ===================== FEATURES ===================== -->
<section class="bg-white px-6 py-16 md:px-12 lg:px-15">
    <div class="mx-auto max-w-9xl">
      <!-- Intro: ícono + texto -->
<div class="mx-auto grid max-w-3xl items-center gap-8 md:grid-cols-[auto_1fr] md:gap-12">
  <div class="relative h-28 w-28 xl:h-35 xl:w-35">
    <img
        src="/icons/Capa.svg"
        alt=""
        class="h-full w-full"
    />

    <img
        src="/icons/Tilde.svg"
        alt=""
        class="absolute left-1/2 top-1/2 h-9 w-9 -translate-x-1/2 -translate-y-1/2 lg:h-12 lg:w-12"
    />
</div>

    <div class="font-light">
        <h2 class="text-2xl leading-8 font-light md:text-3xl">
            No somos una consultora genérica.
            <strong class="block font-semibold">
                Conocemos las industrias <br> desde adentro.
            </strong>
        </h2>

        <p class="mt-4 text-md leading-5">
            Llevamos años implementando sistemas en industrias locales,
            resolviendo problemas concretos y acompañando organizaciones en
            procesos de cambio complejos.
        </p>

        <p class="mt-3 text-md leading-5">
            Eso nos permite hacer algo que pocos pueden: diagnosticar con
            precisión, proponer con criterio y acompañar con compromiso.
        </p>
    </div>
</div>
   
      <!-- Features -->
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          features.map((feature) => (
            <div class="rounded-lg bg-primary-light px-12 py-10">
              <div class="flex h-10 w-10 mb-8 items-center justify-center rounded-lg bg-secondary">
                <img
                src={feature.icon}
                alt=""
                class="h-5 w-5"
                loading="lazy"
            />
              </div>
              <h3 class="mt-4  text-3xl font-semibold ">{feature.title}</h3>
              <p class="mt-2 text-sm font-light leading-5">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
</section>
