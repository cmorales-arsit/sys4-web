---
interface Feature {
  title: string;
  description: string;
}
 
const features: Feature[] = [
  {
    title: "Monitoreo en tiempo real",
    description:
      "Seguí el estado de tu producción en el momento en que ocurre. Sin demoras, sin reportes manuales, sin sorpresas al final del turno.",
  },
  {
    title: "Medición de rendimiento y eficiencia",
    description:
      "Conocé el OEE de cada línea, máquina o proceso. Identificá dónde se pierde tiempo, qué frena la producción y dónde están las oportunidades de mejora.",
  },
  {
    title: "Trazabilidad completa",
    description:
      "Seguimiento de materiales, lotes y procesos desde el ingreso de la materia prima hasta el producto terminado. Control total sobre lo que producís y cómo lo producís.",
  },
  {
    title: "Gestión de ordenes de fabricación",
    description:
      "Planificación, asignación de recursos y seguimiento de órdenes en un solo lugar. Cada operario sabe qué hacer, cuándo y con qué.",
  },
  {
    title: "Detección de cuellos de botella",
    description:
      "El sistema identifica automáticamente los puntos críticos que frenan tu producción. Actuá antes de que el problema se convierta en parada.",
  },
  {
    title: "Integración con ERP SYS4",
    description:
      "MES y ERP trabajan como uno solo. La información de planta alimenta directamente la gestión administrativa, financiera y de stock. Sin duplicación de datos, sin errores de transferencia.",
  },
];

interface Situation {
  title: string;
  description: string;
  image: string;
}
 
const situations: Situation[] = [
  {
    title: "La planta produce, pero los números no cierran.",
    description: "Hay actividad, pero los costos reales de producción son difíciles de calcular.",
    image: "/images/soluciones/mes/Img-mes-2.png",
  },
  {
    title: "No sé exactamente dónde se pierde el tiempo.",
    description: "Los tiempos muertos existen, pero nadie tiene un registro preciso de cuánto ni por qué.",
    image: "/images/soluciones/mes/Img-mes-3.png",
  },
  {
    title: "Cuando detecto el problema, ya es tarde.",
    description: "Las fallas aparecen cuando ya afectaron la producción o los plazos de entrega.",
    image: "/images/soluciones/mes/Img-mes-4.png",
  },
  {
    title: "Tomo decisiones de planta sin datos confiables.",
    description: "Los reportes llegan tarde, son manuales o no reflejan lo que realmente pasó.",
    image: "/images/soluciones/mes/Img-mes-5.png",
  },
];

interface Etapa {
    numero: number;
    titulo: string;
    descripcion: string;
}

const etapas: Etapa[] = [
    {
        numero: 1,
        titulo: "Planificación",
        descripcion:
            "Las órdenes de fabricación se generan y asignan con recursos, tiempos y materiales definidos.",
    },
    {
        numero: 2,
        titulo: "Ejecución",
        descripcion:
            "Los operarios reciben instrucciones precisas. El sistema registra lo que ocurre en planta en tiempo real.",
    },
    {
        numero: 3,
        titulo: "Monitoreo",
        descripcion:
            "Supervisores y gerentes ven el estado de la producción en dashboards claros y actualizados al instante.",
    },
    {
        numero: 4,
        titulo: "Análisis",
        descripcion:
            "Los datos de planta se convierten en indicadores accionables: OEE, tiempos, desperdicios, rendimiento por línea o turno.",
    },
    {
        numero: 5,
        titulo: "Decisión",
        descripcion:
            "Con información confiable, las decisiones llegan a tiempo y con respaldo real.",
    },
];

interface Perfil {
    titulo: string;
    imagen: string;
    alt: string;
    descripcion: string;
}

const perfiles: Perfil[] = [
    {
        titulo: "Gerentes de producción",
        imagen: "/images/soluciones/mes/Img-mes-6.png",
        alt: "Gerentes de producción",
        descripcion:"Visibilidad total sobre el proceso. Decisiones basadas en datos, no en intuición.",
    },
    {
        titulo: "Supervisores de planta",
        imagen: "/images/soluciones/mes/Img-mes-7.png",
        alt: "Supervisores de planta",
        descripcion:"Control en tiempo real de cada línea, máquina y operario. Actuación inmediata ante cualquier desvío.",
    },
    {
        titulo: "Directores / Dueños de industria",
        imagen: "/images/soluciones/mes/Img-mes-8.png",
        alt: "Directores y dueños de industria",
        descripcion:"Rentabilidad real de la operación. Sin costos ocultos, sin ineficiencias invisibles.",
    },
];
---


<!-- ===================== PRINCIPAL ===================== -->
<section class="relative flex min-h-[620px] w-full items-center overflow-hidden md:min-h-[680px]">
	<!-- Imagen de fondo -->
	<img
		src="/images/soluciones/mes/Banner.png"
		alt=""
		class="absolute inset-0 -z-10 h-full w-full object-cover"
		style="object-position: 30% 40%;"
	/>
 
	<!-- Contenido -->
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pt-32 sm:px-6 md:flex-row md:items-end md:gap-10 md:pt-22">
		<div class="flex max-w-lg flex-col">
			<h1 class="text-3xl leading-12 md:leading-16 font-light text-white md:text-4xl lg:text-5xl">
				Tu planta produce.
				<strong class="block font-semibold">¿Sabés exactamente</strong>
				<strong class="block font-semibold">cuánto rinde?</strong>
			</h1>
 
			<p class="mt-12 max-w-md text-base leading-5 font-light text-white md:text-base">
				MES SYS4 te da visibilidad total sobre tu proceso productivo en tiempo real. Medí
				rendimiento, detectá ineficiencias y tomá decisiones con datos concretos, no con
				estimaciones.
			</p>
		</div>
 
		<a
			href="/contacto"
			class="flex w-fit shrink-0 items-center gap-2 rounded-xs md:ms-12 mb-3 bg-secondary px-6 py-3 text-base font-light text-white transition-colors"
		>
			Agendá una demo
			<img
				src="/icons/VerMas.svg"
				alt=""
				class="ms-6 h-3 w-3"
			/>
		</a>
	</div>
</section>

<!-- ===================== FEATURES ===================== -->
<section class="bg-white px-6 py-10 md:px-12 lg:px-10">
    <div class="mx-auto max-w-6xl">
      <!-- Intro: texto + imagen -->
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-12">

        <!-- Texto -->
        <div>
            <h2
                class="max-w-md text-3xl font-light leading-9 md:text-3xl"
            >
                Actividad no es eficiencia.
                <strong class="block font-semibold">
                    La diferencia está en los datos.
                </strong>
            </h2>

            <div class="max-w-md leading-relaxed">
                <p class="mt-5 text-lg leading-5 md:text-base font-light">
                    El MES SYS4 conecta tu planta con la información que necesitás para tomar el control. Desde el lanzamiento de la orden de fabricación hasta el producto terminado, cada etapa queda registrada, medida y disponible para quien tiene que decidir.
                </p>
            </div>
        </div>

        <!-- Imagen -->
        <div class="overflow-hidden">
            <img
                src="/images/soluciones/mes/Img-mes-1.png"
                alt=""
                class="h-[240px] w-full max-w-[420px] object-cover md:h-[320px] md:w-[570px] md:max-w-none"
                loading="lazy"
            />
        </div>

    </div>
   
      <!-- Grid de beneficios -->
      <div class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div>
              <div class="relative flex h-16 w-16 items-center justify-center">
                <img
                    src="/icons/Capa.svg"
                    alt=""
                    class="h-18 w-18"
                />

                <!-- Imagen centrada encima -->
                    <img
                        src="/icons/Tilde.svg"
                        alt=""
                        class="absolute left-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2"
                    />
              </div>
              
              <div>
    <h3 class="mt-4 max-w-[290px] text-3xl font-semibold">
        {feature.title}
    </h3>

    <p class="mt-2 max-w-[300px] text-lg leading-5 md:max-w-[260px] md:text-sm">
        {feature.description}
    </p>
</div>
            </div>
          ))
        }
      </div>
    </div>
</section>

<!-- ===================== SITUACIONES ===================== -->
<section class="bg-white px-6 py-16 md:px-12 lg:px-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mx-auto max-w-md text-2xl font-semibold leading-snug  md:text-4xl">
        ¿Te identificás con alguna de estas situaciones?
      </h2>
   
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          situations.map((item) => (
            <div class="relative aspect-square overflow-hidden">
              <img src={item.image} alt={item.title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
   
              <div class="relative pt-[12%] mx-auto flex h-full max-w-[300px] leading-2 flex-col items-center justify-start p-6 text-center">
                
                <h3 class="font-stack-soft text-2xl font-light leading-7 text-white">{item.title}</h3>
                <p class="mt-3 text-sm text-white font-light">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
   
      <p class="mx-auto text-2xl mt-18 max-w-md text-center leading-8 font-light md:text-3xl">
        Si alguna de estas situaciones te resulta familiar,
        <strong class="block font-semibold">tu planta necesita un MES.</strong>
      </p>
    </div>
</section>

<!-- ===================== ETAPAS ===================== -->
<section class="bg-primary-light px-6 py-14 md:px-12 lg:px-20">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-8 lg:flex-row lg:items-start lg:justify-center lg:gap-12">

        <!-- Título -->
        <div class="w-full max-w-[380px] shrink-0">
            <h2 class="text-2xl leading-tight sm:text-3xl">
                De la orden de fabricación
                al producto terminado,
                <strong class="block font-semibold">
                    con control en cada etapa.
                </strong>
            </h2>
        </div>

        <!-- Etapas -->
        <div class="flex w-full max-w-[550px] flex-col gap-6 lg:gap-2">
            {
                etapas.map((etapa) => (
                    <div class="flex flex-col items-center lg:flex-row lg:items-center lg:gap-3">

                        <!-- Número -->
                        <div class="relative z-10 mb-2 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary text-sm font-light text-white lg:mb-0 lg:h-6 lg:w-6 lg:me-4">
                            {etapa.numero}
                        </div>

                        <!-- Contenido -->
                        <div class="flex w-full flex-col items-center rounded-3xl bg-white px-5 py-4 text-center lg:min-h-10 lg:flex-row lg:items-center lg:px-4 lg:py-2 lg:text-left">

                            <h3 class="text-base font-semibold text-secondary lg:w-20 lg:shrink-0 lg:text-md">
                                {etapa.titulo}
                            </h3>

                            <p class="mt-2 text-sm font-light leading-tight lg:ms-8 lg:mt-0">
                                {etapa.descripcion}
                            </p>

                        </div>

                    </div>
                ))
            }
        </div>

    </div>
</section>

<!-- ===================== DISEÑO ===================== -->
<section class="bg-white px-6 py-14 md:px-12 lg:px-20">
    <div class="mx-auto max-w-4xl">

        <!-- Título -->
        <h2 class="mx-auto max-w-xl text-center text-2xl leading-tight text-slate-900 sm:text-3xl">
            MES SYS4 está diseñado para industrias que producen y necesitan saber
            exactamente cómo lo hacen.
        </h2>
    
        <!-- Cards -->
        <div class="mx-auto mt-8 grid max-w-4xl gap-4 md:grid-cols-3">
    
            {
                perfiles.map((perfil) => (
                    <div class="flex min-h-[420px] flex-col overflow-hidden">
    
                        <div class="h-64 w-full overflow-hidden">
                            <img
                                src={perfil.imagen}
                                alt={perfil.alt}
                                class="h-full w-full object-cover"
                                loading="lazy"
                            />
                        </div>
    
                        <div class="flex flex-1 flex-col bg-primary-light px-4 py-6 text-center">
                            <h3 class="mx-auto max-w-[250px] md:max-w-[180px] text-2xl md:text-lg font-semibold leading-tight text-primary">
                                {perfil.titulo}
                            </h3>
    
                            <p class="mx-auto mt-3 max-w-[250px] md:max-w-[190px] text-md md:text-xs leading-tight">
                                {perfil.descripcion}
                            </p>
                        </div>
    
                    </div>
                ))
            }
    
        </div>
    </div>
</section>