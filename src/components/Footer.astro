---
interface LinkItem {
    nombre: string;
    href: string;
}

interface FooterSection {
    titulo: string;
    links: LinkItem[];
}

interface SocialLink {
    nombre: string;
    href: string;
    icono: string;
}

const soluciones: LinkItem[] = [
    {
        nombre: "ERP",
        href: "/soluciones/erp",
    },
    {
        nombre: "MES",
        href: "/soluciones/mes",
    },
    {
        nombre: "Oracle by SYS4",
        href: "#",
    },
];

const industrias: LinkItem[] = [
    {
        nombre: "Constructoras",
        href: "/industrias/constructoras",
    },
    {
        nombre: "Manufacturas",
        href: "/industrias/manufacturas",
    },
    {
        nombre: "Servicios",
        href: "/industrias/servicios",
    },
    {
        nombre: "Comercializadoras",
        href: "/industrias/comercializadoras",
    },
    {
        nombre: "Contadores",
        href: "/industrias/contadores",
    },
    {
        nombre: "ONG",
        href: "/industrias/ong",
    },
];

const consultoria: LinkItem[] = [
    {
        nombre: "SYS4 Consulting",
        href: "/consultoria",
    },
];

const nosotros: LinkItem[] = [
    {
        nombre: "Presentación SYS4",
        href: "/nosotros/presentacion",
    },
    {
        nombre: "Políticas de Calidad",
        href: "/nosotros/politicadecalidad",
    },
];

const otrosServicios: LinkItem[] = [
    {
        nombre: "Remates Online",
        href: "/remates",
    },
];

const contacto: LinkItem[] = [
    {
        nombre: "Trabajá con nosotros",
        href: "/trabajaconnosotros",
    },
];

const redesSociales: SocialLink[] = [
    {
        nombre: "LinkedIn",
        href: "https://www.linkedin.com/company/sys4desarrollodesoftware/posts/",
        icono: "/icons/Linkedin.svg",
    },
    {
        nombre: "Instagram",
        href: "https://www.instagram.com/sys4_software/",
        icono: "/icons/Instagram.svg",
    },
    {
        nombre: "YouTube",
        href: "#",
        icono: "/icons/Youtube.svg",
    },
    {
        nombre: "WhatsApp",
        href: "#",
        icono: "/icons/Whatsapp.svg",
    },
];
---

<footer class="w-full bg-primary text-white">
    <div class="mx-auto max-w-5xl px-6 pt-28 pb-12">
        <!-- Contenido principal -->
        <div
            class="grid grid-cols-1 gap-10 text-center sm:grid-cols-2 lg:grid-cols-7 lg:gap-6 lg:text-left"
        >
            <!-- Logo + descripción + redes -->
            <div class="lg:col-span-2">
                <a href="/" class="inline-block">
                    <img
                        src="/logo.png"
                        alt="Sys4"
                        class="mx-auto h-8 w-auto brightness-0 invert lg:mx-0"
                    />
                </a>

                <p class="mt-3 text-md leading-4 font-light text-white">
                    <strong>Orden y sistema.</strong>
                </p>

                <!-- Redes sociales -->
                <div
                    class="mt-12 flex items-center justify-center gap-2 lg:justify-start"
                >
                    {
                        redesSociales.map((red) => (
                            <a
                                href={red.href}
                                aria-label={red.nombre}
                                class="flex h-7 w-7 items-center justify-center rounded-full bg-white transition hover:bg-secondary"
                            >
                                <img
                                    src={red.icono}
                                    alt={red.nombre}
                                    class="h-4 w-4"
                                />
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Soluciones -->
            <div class="lg:col-span-1">
                <h3 class="text-sm font-semibold">Soluciones</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        soluciones.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Industrias -->
            <div class="lg:col-span-1">
                <h3 class="text-sm font-semibold">Industrias</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        industrias.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Consultoría -->
            <div class="lg:col-span-1">
                <h3 class="text-sm font-semibold">Consultoría</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        consultoria.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Nosotros -->
            <div class="lg:col-span-1">
                <h3 class="text-sm font-semibold">Nosotros</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        nosotros.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <!-- Otros Servicios -->
                <h3 class="mt-8 text-sm font-semibold">Otros Servicios</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        otrosServicios.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Contacto -->
            <div class="lg:col-span-1">
                <h3 class="text-sm font-semibold">Contacto</h3>

                <ul class="mt-4 space-y-3 text-sm text-white">
                    {
                        contacto.map((item) => (
                            <li>
                                <a href={item.href} class="text-white font-light">
                                    {item.nombre}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <!-- Datos de contacto -->
        <div
            class="mt-12 flex flex-col items-center gap-5 text-sm text-white/80 md:flex-row md:items-start md:justify-start md:gap-8"
        >
            <!-- Ubicación -->
            <div class="flex items-center text-white font-light gap-2">
                <img
                    src="/icons/Ubicacion.svg"
                    alt=""
                    class="h-4 w-4"
                />

                <span>Roma 2296, Río Cuarto, Córdoba</span>
            </div>

            <!-- Teléfono -->
            <span
                class="flex items-center gap-2 font-light text-white"
            >
                <img
                    src="/icons/Telefono.svg"
                    alt=""
                    class="h-4 w-4"
                />

                <span>+54 9 3585 74-7718</span>
            </span>

            <!-- Email -->
            <span
                class="flex items-center font-light gap-2 text-white"
            >
                <img
                    src="/icons/Email.svg"
                    alt=""
                    class="h-4 w-4"
                />

                <span>ventas@sys4.com.ar</span>
            </span>
        </div>

        <!-- Línea separadora -->
        <div
            class="mt-5 -mx-4 border-b border-white/30 sm:-mx-6 md:-mx-10 lg:-mx-30"
        >
        </div>

        <!-- Copyright -->
        <div
            class="mt-6 flex flex-col font-light items-center gap-2 text-sm text-white sm:flex-row sm:justify-between"
        >
            <span>© 2026 SYS4. Todos los derechos reservados.</span>

            <span>Córdoba - Argentina</span>
        </div>
    </div>
</footer>