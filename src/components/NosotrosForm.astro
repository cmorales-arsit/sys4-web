<footer class="w-full px-4 py-10 sm:px-6">
    <div class="mx-auto w-full max-w-6xl">
        <div class="grid grid-cols-1 overflow-hidden md:grid-cols-2">
            <!-- Lado Izquierdo: Imagen -->
            <div class="relative min-h-[260px] md:min-h-full">
                <img
                    src="/images/trabajaconnosotros/Img-1.png"
                    alt="Persona trabajando en laptop"
                    class="h-full w-full object-cover"
                />
            </div>

            <!-- Lado Derecho: Formulario -->
            <div
                class="flex flex-col justify-center bg-primary p-5 text-white sm:p-6 md:p-8"
            >
                <!-- Título -->
                <slot name="titulo" />

                <!-- Descripción -->
                <slot name="descripcion" />

                <form class="mt-4 space-y-2" onsubmit="event.preventDefault();">
                    <!-- Nombre y apellido -->
                    <input
                        type="text"
                        placeholder="Nombre y apellido"
                        class="w-full rounded-md bg-white px-4 py-2 text-sm text-black placeholder:text-black focus:outline-none"
                        "
                        required
                    />

                    <!-- Teléfono / Email -->
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <input
                            type="tel"
                            placeholder="Teléfono"
                            class="w-full rounded-md bg-white px-4 py-2 text-sm text-black placeholder:text-black focus:outline-none"
                            required
                        />

                        <input
                            type="email"
                            placeholder="Email"
                            class="w-full rounded-md bg-white px-4 py-2 text-sm text-black placeholder:text-black focus:outline-none"
                            required
                        />
                    </div>

                    <!-- ¿A qué te dedicás? -->
                    <input
                        type="text"
                        placeholder="¿A qué te dedicás?"
                        class="w-full rounded-md bg-white px-4 py-2 text-sm text-black placeholder:text-black focus:outline-none"
                    />

                    <!-- ¿Por qué querés trabajar en SYS4? -->
                    <input
                        type="text"
                        placeholder="¿Por qué querés trabajar en SYS4?"
                        class="w-full rounded-md bg-white px-4 py-2 text-sm text-black placeholder:text-black focus:outline-none"
                    />

                    <!-- Adjuntar CV / Botón -->
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <!-- Adjuntar CV -->
                        <label
                            class="flex cursor-pointer items-center justify-between rounded-md bg-white px-4 py-2 text-sm text-black transition-colors"
                        >
                            <span class="truncate font-normal">
                                Adjuntar CV
                            </span>

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 shrink-0 text-gray-800"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                                ></path>
                            </svg>

                            <input
                                type="file"
                                class="hidden"
                                accept=".pdf,.doc,.docx"
                            />
                        </label>

                        <!-- Botón -->
                        <button
                            type="submit"
                            class="w-full rounded-md bg-secondary px-4 py-3 text-base font-medium text-white transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-secondary sm:py-2 sm:text-sm"
                        >
                            Enviar mi información
                        </button>
                    </div>
                </form>

                <!-- Redes sociales -->
                <div class="mt-6 flex justify-center gap-3 text-white">
                    <!-- Facebook -->
                    <a
                        href="#"
                        aria-label="Facebook"
                        class="transition "
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="h-7 w-7"
                        >
                            <path
                                d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073c0 6.019 4.388 11.002 10.125 11.927v-8.432H7.078v-3.422h3.047V9.534c0-3.027 1.792-4.7 4.533-4.7 1.313 0 2.686.236 2.686.236v2.973h-1.514c-1.491 0-1.955.93-1.955 1.885v2.218h3.328l-.532 3.422h-2.796V24C19.612 23.075 24 18.092 24 12.073z"
                            ></path>
                        </svg>
                    </a>

                    <!-- Instagram -->
                    <a
                        href="https://www.instagram.com/sys4_software/"
                        aria-label="Instagram"
                        class="flex h-7 w-7 items-center justify-center rounded-full bg-white text-primary transition "
                    >
                        <img
                            src="/icons/Instagram.svg"
                            alt="Instagram"
                            class="h-4 w-4"
                        />
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>
