---
import { OptionsItems } from "../forms/selectItemse";
---

<section class="w-full sm:px-6">
    <div class="mx-auto w-full max-w-5xl">
        <!-- Formulario -->
        <div class="w-full rounded-sm bg-primary px-5 py-8 sm:px-10 md:px-12">
            <!-- Título -->
            <slot name="titulo" />

            <slot name="descripcion" />

            <form class="flex flex-col gap-2">
                <!-- Nombre -->
                <input
                    type="text"
                    placeholder="Nombre y apellido"
                    class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                />

                <!-- Empresa / Email -->
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <input
                        type="text"
                        placeholder="Empresa"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />

                    <input
                        type="email"
                        placeholder="Email"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />
                </div>

                <!-- Teléfono / Solución -->
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                    <input
                        type="tel"
                        placeholder="Teléfono"
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                    />

                    <select
                        class="h-9 w-full rounded bg-white px-3 text-sm outline-none focus:ring-2 focus:ring-secondary"
                        aria-label="¿Qué solución te interesa?"
                    >
                        <option value="" selected disabled>
                            ¿Qué solución te interesa?
                        </option>

                        {
                            OptionsItems.map((option) => (
                                <option value={option.value}>
                                    {option.label}
                                </option>
                            ))
                        }
                    </select>
                </div>

                <!-- ¿Cómo podemos ayudarte? -->
                <textarea
                    placeholder="¿Cómo podemos ayudarte?"
                    rows="4"
                    class="w-full resize-none rounded bg-white px-3 py-2 text-sm outline-none placeholder:text-black focus:ring-2 focus:ring-secondary"
                ></textarea>

                <!-- Botón -->
                <button
                    type="submit"
                    class="mt-1 h-9 w-full cursor-pointer rounded bg-secondary text-sm font-medium text-white transition"
                >
                    Quiero que me contacten
                </button>
            </form>

            <!-- Redes sociales -->
            <div class="mt-6 flex justify-center gap-3 text-white">
                <!-- Facebook -->
                <a
                    href="https://www.facebook.com/sys4software/"
                    aria-label="Facebook"
                    class="flex h-7 w-7 items-center justify-center transition"
                >
                    <img
                        src="/icons/Facebook.svg"
                        alt="Instagram"
                        class="h-9 w-9"
                    />
                </a>

                <!-- Instagram -->
                <a
                    href="https://www.instagram.com/sys4_software/"
                    aria-label="Instagram"
                    class="flex h-7 w-7 items-center justify-center rounded-full bg-white text-primary transition"
                >
                    <img
                        src="/icons/Instagram.svg"
                        alt="Instagram"
                        class="h-4 w-4"
                    />
                </a>
            </div>
        </div>
    </div>
</section>
