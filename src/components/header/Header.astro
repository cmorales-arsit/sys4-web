---
import DesktopNav from "./DesktopNav.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
    transparentHeader?: boolean;
    logoBlanco?: boolean;
}

const { transparentHeader = false, logoBlanco = false } = Astro.props;
---

<header
    class={
        transparentHeader
            ? "absolute inset-x-0 top-0 z-50 w-full bg-transparent"
            : "absolute inset-x-0 top-0 z-50 w-full bg-white"
    }
>
    <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-8 sm:px-14 md:px-24 xl:px-6"
    >
        <!-- Logo -->
        <a href="/" class="shrink-0">
            <img
                src="/logo.png"
                alt="Sys4"
                class={
                    logoBlanco
                        ? "h-7 w-auto brightness-0 invert"
                        : "h-7 w-auto"
                }
            />
        </a>

        <!-- Navegación desktop -->
        <div class="hidden lg:block">
            <DesktopNav />
        </div>

        <!-- Navegación mobile -->
        <div class="lg:hidden">
            <MobileNav />
        </div>

        <!-- Instagram -->
        <a
            href="https://www.instagram.com/sys4_software/"
            aria-label="Instagram"
            class="hidden h-5 w-5 items-center justify-center rounded-full bg-primary transition hover:bg-secondary lg:flex"
        >
            <img
                src="/icons/Instagram-1.svg"
                alt="Instagram"
                class="h-3 w-3"
            />
        </a>
    </div>
</header>