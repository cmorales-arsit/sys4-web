---
import { navItems } from "./navItems";

const rutaActual = Astro.url.pathname;
---

<nav class="hidden items-center lg:flex">
    {
        navItems.map((item, index) =>
            item.nombre === "Soluciones" ? (
                <div class="group relative">
                    <span
                        class:list={[
                            "flex h-7 cursor-default items-center rounded-sm px-3 text-xs font-medium text-white transition xl:px-5 xl:text-sm",
                            rutaActual.startsWith("/soluciones")
                                ? "bg-secondary"
                                : "bg-primary hover:bg-primary-soft",
                        ]}
                    >
                        {item.nombre}
                    </span>

                    <div class="invisible absolute left-0 top-full z-50 mt-1 w-36 overflow-hidden rounded-sm bg-primary opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 xl:w-40">
                        <a
                            href="/soluciones/erp"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            ERP
                        </a>

                        <a
                            href="/soluciones/mes"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            MES
                        </a>
                    </div>
                </div>
            ) : item.nombre === "Industrias" ? (
                <div class="group relative">
                    <span
                        class:list={[
                            "flex h-7 cursor-default items-center rounded-sm px-3 text-xs font-medium text-white transition xl:px-5 xl:text-sm",
                            rutaActual.startsWith("/industrias")
                                ? "bg-secondary"
                                : "bg-primary hover:bg-primary-soft",
                        ]}
                    >
                        {item.nombre}
                    </span>

                    <div class="invisible absolute left-0 top-full z-50 mt-1 w-44 overflow-hidden rounded-sm bg-primary opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 xl:w-48">
                        <a
                            href="/industrias/constructoras"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Constructoras
                        </a>

                        <a
                            href="/industrias/manufacturas"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Manufacturas
                        </a>

                        <a
                            href="/industrias/servicios"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Servicios
                        </a>

                        <a
                            href="/industrias/comercializadoras"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Comercializadoras
                        </a>
                    </div>
                </div>
            ) : item.nombre === "Nosotros" ? (
                <div class="group relative">
                    <span
                        class:list={[
                            "flex h-7 cursor-default items-center rounded-sm px-3 text-xs font-medium text-white transition xl:px-5 xl:text-sm",
                            rutaActual.startsWith("/nosotros")
                                ? "bg-secondary"
                                : "bg-primary hover:bg-primary-soft",
                        ]}
                    >
                        {item.nombre}
                    </span>

                    <div class="invisible absolute left-0 top-full z-50 mt-1 w-44 overflow-hidden rounded-sm bg-primary opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 xl:w-48">
                        <a
                            href="/nosotros/presentacion"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Presentación
                        </a>

                        <a
                            href="/nosotros/politicadecalidad"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Política de calidad
                        </a>
                    </div>
                </div>
            ) : item.nombre === "Contacto" ? (
                <div class="group relative">
                    <span
                        class:list={[
                            "flex h-7 cursor-default items-center rounded-sm px-3 text-xs font-medium text-white transition xl:px-5 xl:text-sm",
                            rutaActual.startsWith("/contacto") ||
                            rutaActual.startsWith("/remates") ||
                            rutaActual.startsWith("/trabajaconnosotros")
                                ? "bg-secondary"
                                : "bg-primary hover:bg-primary-soft",
                        ]}
                    >
                        {item.nombre}
                    </span>

                    <div class="invisible absolute right-0 top-full z-50 mt-1 w-44 overflow-hidden rounded-sm bg-primary opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 xl:w-48">
                        <a
                            href="/contacto"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Contacto
                        </a>

                        <a
                            href="/remates"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Remates
                        </a>

                        <a
                            href="/trabajaconnosotros"
                            class="block px-4 py-2.5 text-xs font-medium text-white transition-colors hover:bg-primary-soft xl:px-5 xl:py-3 xl:text-sm"
                        >
                            Trabajá con nosotros
                        </a>
                    </div>
                </div>
            ) : (
            <a
                    href={item.href}
                    class:list={[
                        "flex h-7 items-center rounded-sm px-3 text-xs font-medium text-white transition xl:px-5 xl:text-sm",
                        item.href === rutaActual ||
                        (item.nombre === "Consultoría" &&
                            rutaActual.startsWith("/consultoria"))
                            ? "bg-secondary"
                            : "bg-primary hover:bg-primary-soft",
                        index === 0 && "rounded-sm rounded-l-sm",
                        index === navItems.length - 1 &&
                            "rounded-sm rounded-r-sm",
                    ]}
                >
                    {item.nombre}
                </a>
            ),
        )
    }
</nav>