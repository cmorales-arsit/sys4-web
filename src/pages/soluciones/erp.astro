---
import Layout from "../../layouts/Layout.astro";
import ERP from "../../components/soluciones/ERP.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Soluciones ERP | Sys4" transparentHeader={true} logoBlanco={true}>
    <ERP />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="text-center text-2xl font-semibold leading-tight text-white sm:text-3xl"
            >
                Contanos en qué etapa está tu <strong>empresa.</strong>
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-sm md:text-2xl font-light text-white sm:text-base">
                Nosotros nos encargamos del resto.
            </p>
        </Fragment>
    </Form>
</Layout>
