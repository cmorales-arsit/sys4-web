---
import Layout from "../../layouts/Layout.astro";
import Constructoras from "../../components/industrias/constructoras.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Constructoras | Sys4" transparentHeader={true}>
    <Constructoras />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="text-center text-2xl font-light leading-tight text-white sm:text-2xl"
            >
            Tu próxima obra puede tener los números bajo control desde el primer día.
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-sm md:text-4xl font-light text-white sm:text-base">
                <strong>Hacelo con Sys4</strong>
            </p>
        </Fragment>
    </Form>
</Layout>