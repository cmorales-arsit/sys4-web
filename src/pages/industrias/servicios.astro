---
import Layout from "../../layouts/Layout.astro";
import Servicios from "../../components/industrias/servicios.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Servicios | Sys4" transparentHeader={true} logoBlanco={true}>
    <Servicios />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="text-center text-2xl font-light leading-tight text-white sm:text-2xl"
            >
            Una empresa de servicios que crece necesita más que buena voluntad. Necesita sistema.
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-sm md:text-4xl font-light text-white sm:text-base">
                <strong>Contactanos</strong>
            </p>
        </Fragment>
    </Form>
</Layout>