---
import Layout from "../../layouts/Layout.astro";
import Contadores from "../../components/industrias/contadores.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Contadores | Sys4" transparentHeader={true} logoBlanco={true}>
    <Contadores />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="text-center text-2xl font-light leading-tight text-white sm:text-2xl"
            >
            La herramienta correcta no te reemplaza. Te potencia.
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-sm md:text-4xl font-light text-white sm:text-base">
                <strong>Contactanos</strong>
            </p>
        </Fragment>
    </Form>
</Layout>