---
import Layout from "../../layouts/Layout.astro";
import Manufacturas from "../../components/industrias/manufacturas.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Manufacturas | Sys4" transparentHeader={true} logoBlanco={true}>
    <Manufacturas />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="text-center text-2xl font-light leading-tight text-white sm:text-2xl"
            >
            Tu planta puede producir mejor de lo que produce hoy. Te lo mostramos. 
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-sm md:text-4xl font-light text-white sm:text-base">
                <strong>Contactanos</strong>
            </p>
        </Fragment>
    </Form>
</Layout>