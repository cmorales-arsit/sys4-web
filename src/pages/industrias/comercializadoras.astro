---
import Layout from "../../layouts/Layout.astro";
import Comercializadoras from "../../components/industrias/comercializadoras.astro";
import Form from '../../components/Form.astro';
---

<Layout title="Comercializadoras | Sys4" transparentHeader={true} logoBlanco={true}>
    <Comercializadoras />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="mt-1 text-center text-xl md:text-xl font-light text-white"
            >
                Vender bien no alcanza si la operación no acompaña.
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p
                class="mt-1 mb-6 text-center text-3xl font-light text-white  md:text-3xl"
            >
                <strong>Hacelo posible con SYS4.</strong>
            </p>
        </Fragment>
    </Form>
</Layout>