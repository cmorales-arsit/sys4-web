---
import Layout from "../../layouts/Layout.astro";
import ONG from "../../components/industrias/ong.astro";
import Form from '../../components/Form.astro';
---

<Layout title="ONG | Sys4" transparentHeader={true}>
    <ONG />
    <Form backGround="bg-primary-light">
        <Fragment slot="titulo">
            <h2
                class="mt-1 text-center text-xl md:text-xl font-light text-white"
            >
            Cuando tu ONG gestiona bien, puede hacer mucho más con lo mismo.
            </h2>
        </Fragment>
    
        <Fragment slot="descripcion">
            <p class="mt-1 mb-6 text-center text-3xl font-light text-white  md:text-2xl">
                <strong>Contactanos</strong>
            </p>
        </Fragment>
    </Form>
</Layout>